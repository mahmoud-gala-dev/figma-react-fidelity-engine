{
  "name": "figma-fidelity-client-mvp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Client-facing offline Figma-to-React design fidelity MVP with six-tool workflow",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test test/*.test.mjs",
    "extract:json": "node scripts/extract-json.mjs",
    "extract:fig": "node scripts/extract-fig.mjs",
    "audit": "node scripts/audit.mjs",
    "storybook": "storybook dev -p 6006 --ci",
    "build-storybook": "storybook build",
    "export:zip": "node scripts/import-export-zip.mjs",
    "audit:visual": "node scripts/visual-audit.mjs",
    "audit:full": "node scripts/audit.mjs && node scripts/visual-audit.mjs",
    "check": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "openfig-core": "^0.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "fflate": "^0.8.2",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "playwright": "^1.55.0",
    "storybook": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "reg-cli": "0.18.16"
  }
}
